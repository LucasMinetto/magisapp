{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "shared/*": [
        "../app/src/shared/*"
      ]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/login.tsx",
    "app/login/**/*.tsx",
    "app/campanha/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "app/src",
    "app/e2e",
    "app/electron.vite.config.ts",
    "app/node_modules",
    "desktop",
    "node_modules"
  ]
}